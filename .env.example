# Copy to .env.local and fill in. Never commit real values.

# Production origin, used for canonical URLs, Open Graph, sitemap and robots.
# Example: https://www.example.com  (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Enquiry delivery (server-only). When empty, the contact form reports that
# online enquiries are not yet connected — it never pretends to succeed.
# Any HTTPS endpoint that accepts a JSON POST works: a Zapier/Make webhook,
# a CRM intake URL, or your own email-sending function.
ENQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as the "Authorization: Bearer <value>" header.
ENQUIRY_WEBHOOK_SECRET=
